    {
      "id": "GZFTewiKL0Ct0b_RqT9wx",
      "type": "text",
      "x": 260.0460392138461,
      "y": 717.2883388300186,
      "width": 555.8272670228016,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 1281869639,
      "version": 645,
      "versionNonce": 231359175,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769948292268,
      "link": null,
      "locked": false,
      "text": "main - точка входа\n\napp - отрисовать выбранную pages и navBar для выбора\n\npages - фабрика для сборки страницы из hooks\n(modelView)\n\nhooks - обработка данных с бекенда или стора,\nуправление состоянием\nпоиска и прочая логика состояния и работы с данными\n(слой model)\n\ncomponents - по факту слой view\n\nlib - это полезные функции проекта\n(конвертация, форматирование и прочие детали)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main - точка входа\n\napp - отрисовать выбранную pages и navBar для выбора\n\npages - фабрика для сборки страницы из hooks (modelView)\n\nhooks - обработка данных с бекенда или стора, управление состоянием\nпоиска и прочая логика состояния и работы с данными (слой model)\n\ncomponents - по факту слой view\n\nlib - это полезные функции проекта\n(конвертация, форматирование и прочие детали)",
      "autoResize": false,
      "lineHeight": 1.25
    },
